#ifndef SPANISH
#ifndef ENGLISH
	STATIC uInit := __InitFun()

	Static Function __InitFun()
	uInit := Nil
	If Type('cPaisLoc') == 'C'

		If cPaisLoc == "ANG"
			STR0001 := "Criaçäo de líquido em disquete"
			STR0002 := " este programa tem o objectivo de criar o ficheiro de líquido em disco."
			STR0003 := " antes de executar este programa  é  necessário registar a visualização do  "
			STR0004 := 'aRquivo. Modulo SIGACFG opçäo CNAB a Receber.'
			STR0005 := "Criaçäo de líquido em disquete"
			STR0008 := "Abandonar"
			STR0009 := "Criaçäo de líquido em disquete"
			STR0010 := "Este programa tem o objectivo de criar o ficheiro de líquido em disco."
			STR0011 := "Antes de correr este programa  é  necessário registar o layout do  "
			STR0012 := "arquivo. Modulo SIGACFG opçäo CNAB a Receber."
			STR0015 := "Abandonar"
			STR0017 := "Abandonar"
			STR0018 := "Líquido Em Disquete"
			STR0019 := "Atenção"
			STR0020 := "Não existe ficheiro referente à data solicitada"
			STR0024 := "/Nome_do_Ficheiro"
		ElseIf cPaisLoc == "PTG"
			STR0001 := "Criaçäo de líquido em disquete"
			STR0002 := " este programa tem o objectivo de criar o ficheiro de líquido em disco."
			STR0003 := " antes de executar este programa  é  necessário registar a visualização do  "
			STR0004 := 'aRquivo. Modulo SIGACFG opçäo CNAB a Receber.'
			STR0005 := "Criaçäo de líquido em disquete"
			STR0008 := "Abandonar"
			STR0009 := "Criaçäo de líquido em disquete"
			STR0010 := "Este programa tem o objectivo de criar o ficheiro de líquido em disco."
			STR0011 := "Antes de correr este programa  é  necessário registar o layout do  "
			STR0012 := "arquivo. Modulo SIGACFG opçäo CNAB a Receber."
			STR0015 := "Abandonar"
			STR0017 := "Abandonar"
			STR0018 := "Líquido Em Disquete"
			STR0019 := "Atenção"
			STR0020 := "Não existe ficheiro referente à data solicitada"
			STR0024 := "/Nome_do_Ficheiro"
		EndIf
		EndIf
	Return Nil
#ENDIF
