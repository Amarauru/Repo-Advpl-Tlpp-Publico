#ifndef SPANISH
#ifndef ENGLISH
	STATIC uInit := __InitFun()

	Static Function __InitFun()
	uInit := Nil
	If Type('cPaisLoc') == 'C'

		If cPaisLoc == "ANG"
			STR0010 := "Ajuste de empenhos (mod.2)"
			STR0011 := "Ordem de producao"
			STR0013 := "1º nivel"
			STR0014 := "Moradas"
			STR0015 := "Explode o 1ºnívelda estrutura de um artigo - <f5>"
			STR0016 := "Empenho por moradas - <f6>"
			STR0017 := "Seleccionar um artigo com estrutura"
			STR0020 := "Já existe registo com esta informação."
			STR0022 := "Não pode ser excluido um empenho que já foi parcialmente baixado."		
			STR0023 := "A op já esta encerrada, mas existem registos de despesa pendentes. deseja colocar os registos de despesa a zeros?"
			STR0026 := "Independente de existirem valores maiores que zero no campo de saldo empenhado ('sal.empenho'), "
			STR0027 := "O conteúdo a ser gravado na confirmação  será zero."
			STR0030 := "A desactivar a opção para zerar o saldo empenhado"
			STR0031 := "Deseja activar a opção para zerar o saldo empenhado para todos os artigos"
			STR0032 := "Zera Empenho Lote/Endereço - <F7>"
		ElseIf cPaisLoc == "PTG"
			STR0010 := "Ajuste de empenhos (mod.2)"
			STR0011 := "Ordem de producao"
			STR0013 := "1º nivel"
			STR0014 := "Moradas"
			STR0015 := "Explode o 1ºnívelda estrutura de um artigo - <f5>"
			STR0016 := "Empenho por moradas - <f6>"
			STR0017 := "Seleccionar um artigo com estrutura"
			STR0020 := "Já existe registo com esta informação."
			STR0022 := "Não pode ser excluido um empenho que já foi parcialmente baixado."		
			STR0023 := "A op já esta encerrada, mas existem registos de despesa pendentes. deseja colocar os registos de despesa a zeros?"
			STR0026 := "Independente de existirem valores maiores que zero no campo de saldo empenhado ('sal.empenho'), "
			STR0027 := "O conteúdo a ser gravado na confirmação  será zero."
			STR0030 := "A desactivar a opção para zerar o saldo empenhado"
			STR0031 := "Deseja activar a opção para zerar o saldo empenhado para todos os artigos"
			STR0032 := "Zera Empenho Lote/Endereço - <F7>"
		EndIf
		EndIf
	Return Nil
#ENDIF
